SHOPIFY_SHOP=rgpbgc-fd.myshopify.com
# Option 1 (recommandée) : app du Dev Dashboard Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option 2 : jeton Admin API d'une ancienne app personnalisée (shpat_...)
SHOPIFY_ADMIN_TOKEN=
ADEX_USER=
ADEX_TOKEN=
# Type de colis Adex (FIX, LGR, MOY, GRD, ONP, BLK, SMD) — FIX par défaut
ADEX_TYPE=FIX
AGENT_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=
# Ignorer les commandes plus anciennes jamais traitées (AAAA-MM-JJ)
LAUNCH_DATE=2026-11-03
